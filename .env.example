# TenderForge 宿主机 .env —— 权威键表
#
# 这份文件是 ENV_FILE_BASE64 的起点，也是「本产品需要哪些配置」的唯一来源。
# docker-compose.yml 的 environment: 是白名单：不在那里列出的变量写进 .env
# 完全没有反应，服务照常起来、照常用默认值、没有任何报错。
# scripts/guardrails/check-env-example.py 在 CI 里守着两者一致。
#
# 三类值，来源不同：
#   [自持]  本产品自己生成，运维保管
#   [平台]  平台线交付（见 doc/DEPLOYMENT_PLAN.md §4）
#   [形态]  部署形态，运维决定
#
# 端口由组织端口登记表分配，那里是唯一被允许分配它的地方（R1：先登记后用号）。
# 本文件里的 APP_PUBLISH_PORT 不是第二个来源，是端口登记表 R2/R3 要求的
# 「回退默认值」——它必须等于登记表里的号，也等于生产容器内口。

# ── 部署形态 ─────────────────────────────────────────────────────────────
# [形态] local / dev / beta / production。部署态会让四个通道的替身拒绝启动。
#        **没有默认值**：compose 用 ${DEPLOY_STAGE:?} 声明它必填。缺省成 local
#        会静默放行替身，而 local 恰好是唯一不触发那道闸门的一档。
# 版本号不在这份文件里——APP_VERSION / GIT_SHA / BUILD_TIME 由镜像构建期注入
# （Dockerfile 的 ARG→ENV），liveness 端点只读不写。能在运行时改写的版本号，
# 回答不了「线上跑的是哪次构建」这个问题。
DEPLOY_STAGE=production
# [形态] 显式降级开关。生产必须是 false——置真会让产品带着编造的身份、
#        编造的权益、不入账的用量和不入账的推理跑起来，而界面一切正常。
ALLOW_MOCK_ON_DEPLOY=false
# [形态] 宿主机发布口。**端口登记表 2026-09-10 分配 4050/4051**（L3 #5 子块
#        4050–4059）。变量名 APP_PUBLISH_PORT 是产品仓的统一约定（同 vxtpl）。
#        端口登记表 R3：这个回退默认值、登记表、生产内口三者必须是同一个数。
APP_PUBLISH_HOST=0.0.0.0
APP_PUBLISH_PORT=4050
# [形态] Temporal UI 只绑回环，不对外。
TEMPORAL_UI_HOST=127.0.0.1
TEMPORAL_UI_PORT=8233
# [形态] 逗号分隔，必须与对外域名一致，否则浏览器直接被 CORS 挡住。
CORS_ALLOWED_ORIGINS=https://tenderforge.vxture.com

# ── 数据库与工作流引擎 [自持] ────────────────────────────────────────────
# PostgreSQL 18。应用以最小权限角色 tenderforge_svc 连库——它没有 DDL 权限，
# 结构由 deploy/database/ddl 单一权威经 db-init.yml 施加（治理规范 §7/§11）。
# 三个口令都没有默认值：compose 用 ${VAR:?} 声明必填，缺一个直接拒绝启动。
# 一个带默认口令的生产数据库等于没有口令，而它不会有任何报错。
DATABASE_PASSWORD=
POSTGRES_ROOT_PASSWORD=
TEMPORAL_DB_PASSWORD=
DATABASE_POOL_SIZE=10
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=temporal:7233

# ── C1 身份（OIDC RP）[平台] ─────────────────────────────────────────────
# 这一对 client 凭据同时解锁登录与<b>全部 S2S 调用</b>——没有第二份 S2S 凭据
# 要申请。缺它时 OIDC 走替身，而部署态拒绝以替身身份启动。
OIDC_RP_ENABLED=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=
OIDC_REDIRECT_URI=https://tenderforge.vxture.com/api/auth/oidc/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://tenderforge.vxture.com/
# 服务端会话。票只活在服务端，浏览器只拿一个不透明的 HttpOnly cookie。
RP_SESSION_TTL=43200
# 生产必须为 true，否则会话 cookie 会在明文连接上被发送。
RP_SESSION_SECURE_COOKIE=true

# ── C2 权益 / C3 用量上行 [平台] ─────────────────────────────────────────
# 同一个地址服务两条通道。凭证是用上面那对 OIDC client 换来的 S2S 票（aud=vxture），
# 没有另一份口令要填。缺地址或缺 OIDC 凭据时两者都落到替身上，
# 而部署态会拒绝启动——用替身上报的表现是「什么都没记到账上」。
# PLATFORM_API_URL 是<b>跨仓契约值</b>：平台 L9 边缘带的 platform-api，
# 走 tailnet 内网、绝不公网（product_230 §1 传输面分级）。这里留空是因为
# tailnet 地址属于运维值；地址本身不变，变的只是哪台机器上写它。
PLATFORM_API_URL=
USAGE_FLUSH_INTERVAL_MS=15000
USAGE_FLUSH_BATCH_SIZE=100

# ── C3 开通事件下发 [平台] ───────────────────────────────────────────────
# 投递地址：https://tenderforge.vxture.com/api/webhooks/vxture
# 路径是通则定死的，所有产品同一个，变的只有域名——不要按产品自拟。
# 未配密钥时接收端<b>拒绝所有投递</b>——放行是最糟的兜底。
# _NEXT 用于轮换：轮换期间两把都认，切换无感。
# 变量名不带产品前缀，与 vxtpl / runos 一致：从样板复制出的下一个智能体无需改名，
# 接产品只填值、不改代码。平台侧的签名密钥在 opera 登记（加密落库），这里填同一个值。
PROVISION_WEBHOOK_SECRET=
PROVISION_WEBHOOK_SECRET_NEXT=

# ── 转化深链与账号中心 [平台] ────────────────────────────────────────────
# 官网：权益不足时的转化落地页，拼成 {WEBSITE_BASE_URL}/{语言}/pricing?product=tenderforge
# ——套餐在官网定价页发布（owner 2026-09-16）。产品只在用户显式点击时打开它，永不自动跳转。
WEBSITE_BASE_URL=https://vxture.com
# 账号中心：个人资料页地址，经 /api/auth/me 下发。
CONSOLE_BASE_URL=https://console.vxture.com

# ── Atlas：唯一模型出口 [平台] ───────────────────────────────────────────
# 配上即切到 POST /v1/chat；不配则退回直连模型供应商，而那条路在部署态
# 拒绝启动。直连能跑且跑得很好，这正是它危险的地方：产品一切正常，
# 只是每一次推理都没进平台的账，月底对量时才会看到一个没人解释得了的缺口。
#
# 注意耦合：Atlas 铸票需要真实 workspace，而本地口令登录的租户是
# local:<用户id>，平台那边不存在。<b>Atlas 在 C1 切换之前无法真正生效。</b>
ATLAS_API_URL=
# 路由不是配置项。operation → endpointCode 的对应只写在
# czghagent_ai.services.atlas_endpoints 一处，四条通用路由均已授权；
# 每条路由挂哪个模型由运营在 Atlas 侧改指向，不需要动这里。

# ── 内部服务间令牌 [自持] ────────────────────────────────────────────────
AI_SERVICE_INTERNAL_TOKEN=
AI_SERVICE_TIMEOUT_SECONDS=600
DOCUMENT_SERVICE_ENABLED=true
DOCUMENT_SERVICE_BASE_URL=http://ai:8000
DOCUMENT_SERVICE_TIMEOUT_SECONDS=1800

# ── 直连模型供应商（仅本地开发；生产由 Atlas 取代）───────────────────────
# 生产环境这一组应全部留空：ATLAS_API_URL 一配上就不再走这条路。
# 留着它们是为了本地空 .env 也能把整个界面探索一遍。
AI_PROVIDER_NAME=DIRECT_DEEPSEEK
AI_MODEL_BASE_URL=
AI_MODEL_API_KEY=
AI_MODEL_REQUEST_DIALECT=deepseek
AI_MODEL_NAME=deepseek-v4-flash
AI_MODEL_FAST_NAME=deepseek-v4-flash
AI_MODEL_QUALITY_NAME=deepseek-v4-pro
# 单次模型调用的预算，直连与 Atlas 共用（Atlas 的 timeoutMs 取它减 2 秒）。
# 旧的 ATLAS_TIMEOUT_SECONDS 已退役：它只有 90 秒，开推理的调用会被 Atlas 按时限取消。
AI_MODEL_TIMEOUT_SECONDS=240
AI_MODEL_STAGE_TIMEOUT_SECONDS=540
AI_MODEL_MAX_RETRIES=1
AI_MODEL_THINKING_BUDGET_TOKENS=4096
AI_MODEL_THINKING_DISABLED_OPERATIONS=project_overview_source_selection,project_overview_extraction,technical_scoring_extraction,outline_skeleton_planning,outline_branch_expansion,chapter_drafting
AI_MODEL_THINKING_ENABLED_OPERATIONS=bid_strategy_planning,branch_blueprint_planning,section_revision,consistency_review

# ── 仅本地：权益与用量替身的分档开关 ─────────────────────────────────────
# 让本地能逐个走遍「免费档」「未订阅」「已过期」「配额用尽」这些分支——
# 它们在真实环境里最难复现，却是用户最先看到的几屏。部署态这些无效。
MOCK_TIER=
MOCK_STATUS=
MOCK_BUNDLED=false
MOCK_USAGE_GATED=false

# ── 标书生成参数 [形态] ──────────────────────────────────────────────────
BID_CHARACTERS_PER_PAGE=700
BID_GENERATION_MAX_CONCURRENCY=3
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=55MB
