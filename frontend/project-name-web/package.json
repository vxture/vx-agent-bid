{
  "name": "czghagent-web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "serve": "npm run dev",
    "dev": "vite --mode dev",
    "dev:beta": "vite --mode beta",
    "dev:prod": "vite --mode prod",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:beta": "tsc -b && vite build --mode beta",
    "build:prod": "tsc -b && vite build --mode prod",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs && vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix --cache",
    "preview": "vite preview",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.90.19",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@vxture/design-system": "latest",
    "@vxture/design-ui": "latest",
    "@vxture/shared": "^2.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.2",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "4.2.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "happy-dom": "20.14.5",
    "prettier": "^3.8.0",
    "tailwindcss": "4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.6",
      "@humanfs/node": "^0.16.8",
      "ajv@6": "^6.14.0",
      "baseline-browser-mapping": "^2.11.0",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "browserslist": "^4.28.7",
      "flatted": "^3.4.2",
      "glob@10": "^10.5.0",
      "js-yaml": "^4.3.2",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "nanoid": "^3.3.18",
      "picomatch": "^4.0.4",
      "postcss": "^8.5.23",
      "rollup": "^4.59.0"
    }
  }
}
